# Tool versions shared by every workflow. Sourced into $GITHUB_ENV by the
# composite actions under .github/actions/; comments and blank lines are
# stripped before that happens.
#
# The Flutter version is not here: it lives in .tool_versions.yaml, which
# subosito/flutter-action reads directly.

JAVA_VERSION=21
YQ_VERSION=v4.53.3

# Extra sdkmanager packages to preinstall. The NDK revision is not listed here:
# it is read straight from android/app/build.gradle.kts so it cannot drift.
ANDROID_SDK_PACKAGES=platforms;android-35 build-tools;35.0.0 platform-tools
