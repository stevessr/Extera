# Tool versions shared by every workflow. Sourced into $GITHUB_ENV by the
# composite actions under .github/actions/; comments and blank lines are
# stripped before that happens.
#
# Deliberately absent:
#   - the Flutter version, which lives in .tool_versions.yaml
#   - any Android API level, which follows flutter.compileSdkVersion
#   - the NDK revision, which is read from android/app/build.gradle.kts

JAVA_VERSION=21
YQ_VERSION=v4.53.3
